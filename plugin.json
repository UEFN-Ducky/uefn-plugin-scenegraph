{
  "id": "scenegraph",
  "kind": "plugin",
  "version": "1.0.26",
  "label": "UEFN Scene Graph",
  "description": "UEFN Scene Graph prefab helpers plus template abilities. Entity CRUD uses nested Epic UEFN MCP (unreal__*). Bundles the scenegraph skill. Serial editor ops (one MCP call per turn).",
  "min_app_version": "1.0.0",
  "default_enabled": true,
  "secret_keys": [],
  "contributes": {
    "agent.tools": {
      "category": "scenegraph",
      "tools": [
        "scene_graph_capabilities",
        "create_empty_prefab",
        "create_prefab_from_entities",
        "instantiate_prefab",
        "convert_actors_to_entities"
      ],
      "intent_pattern": "\\b(prefab|entity\\s*prefab)\\b",
      "plan_tools": [
        "scene_graph_capabilities"
      ]
    },
    "walkthrough": {
      "id": "scenegraph",
      "title": "Scene Graph tools ready",
      "auto_start": "first_enable",
      "settings_tab": "Store",
      "steps": [
        {
          "target": "settings.store.root",
          "title": "Scene Graph tools ready",
          "body": "Scene Graph prefab tools are live. Entity CRUD is nested Epic UEFN MCP (unreal__*). Ask to package or place prefabs.",
          "advance": "next",
          "mode": "rect"
        }
      ]
    }
  },
  "backend": {
    "entry": "backend",
    "register": "register"
  }
}
